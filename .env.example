# ─────────────────────────────────────────────────────────────────────────────
# CEO City · web app — environment
#
#   cp .env.example .env      then fill in the values below
#
# .env is gitignored. Only variables prefixed VITE_ reach the app; all of them
# resolve in one place, src/framework/config/appConfig.ts.
#
# ⚠ EVERYTHING HERE SHIPS TO THE BROWSER. Nothing here can be a secret — the
#   Firebase web API key is public by design (Firebase security comes from
#   the authorized domains and the backend verifying tokens). The backend's
#   service-account key, database password and Gemini key must NEVER go here.
#
# ⚠ Vite reads .env when the dev server STARTS and at BUILD. Restart
#   `npm run dev` after editing.
#
# In Cloud Run the same names are read when the container starts (see the
# Dockerfile), so changing one there needs no rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (CEO City's own project) ────────────────────────────────────────
# WHERE: Firebase console → Project settings → General → Your apps → the web
#        app's config (apiKey, projectId, authDomain).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional — defaults to <project id>.firebaseapp.com.
# VITE_FIREBASE_AUTH_DOMAIN=

# ── The CEO City backend ─────────────────────────────────────────────────────
# Local: the backend run from academy-backend (go run ./cmd/server).
# Production: the backend's Cloud Run URL.
VITE_API_BASE_URL=http://localhost:8080

# ── Dev only ─────────────────────────────────────────────────────────────────
# VITE_DEV_WORLD=1 opens the city without signing in, for looking at the world
# locally. Never set in production (it is compiled out of production builds).
# VITE_DEV_WORLD=1
