# CEO City — nginx site config for the production image.
#
# A template: the nginx image substitutes ${PORT} at container start (Cloud Run
# sets PORT). nginx's own variables ($uri and friends) are left alone, because
# only names that exist in the environment are substituted.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compress the text formats; images, audio and fonts already are.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Vite's own bundles carry a content hash in the name (index-DlBvG-28.js),
    # so a changed file is a new URL and the old one can be cached forever.
    location ~* "^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Everything else under /assets comes from public/ with its name unchanged
    # (audio, icons, city sprites), so it must be able to change: cache for a
    # day, then check again.
    location /assets/ {
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The runtime settings, written at container start: never cached, so a new
    # value on the Cloud Run service reaches players on their next load.
    location = /config.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # The app shell is never cached, so a deploy reaches players on their next
    # load rather than whenever their cache expires.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # A single-page app: any other path is the app itself.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
